{
  "name": "jungl3-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Scripted cinematic terminal walkthrough of a Jungl3 sprint. No network, no AWS, no real infrastructure.",
  "type": "module",
  "bin": {
    "jungl3-demo": "dist/bin/jungl3-demo.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin/jungl3-demo.js",
    "start": "node dist/bin/jungl3-demo.js",
    "smoke": "node dist/scripts/smoke.js",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "cli-truncate": "^4.0.0",
    "figures": "^6.1.0",
    "ink": "^5.0.1",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^3.0.0",
    "picocolors": "^1.1.1",
    "react": "^18.3.1",
    "string-width": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18.17"
  }
}
